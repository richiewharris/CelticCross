rules_version = '2';

// Security rules for Celtic Cross Games.
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
//
// games/{id}: one online game by invite. Anyone signed in (anonymously) who has the link can read it.
//   Players can only: take an empty seat, add exactly one move on their own turn, resign, or offer a
//   rematch; and its creator can delete it while nobody else has joined (calling it off). Moves are checked against the game's rules by both players' browsers on replay.
// stats/games: public "games played" tallies; anyone may add exactly 1 to one known game.
// races/{id}: a two-player Celtic Cross Lock race. Only the creator creates it (and may delete it while it is
//   still open and nobody has joined); one other player takes
//   the empty seat once; each racer sets only their own Ready flag and writes only their own run, whose
//   counts only grow, whose bonus and penalty must follow from them, and which freezes once finished,
//   within a window from the server-stamped start. races/{id}/scores/{uid}: one challenge score per
//   player (not the racers), begun at a server-stamped start, growing only within the same window, and
//   frozen once finished. Clocks run in the browsers, so a racer could still report solves they didn't
//   make: these rules bound what a report can say, not whether it is true.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    match /games/{gameId} {
      function onlineGame(g) { return g in ['monsiv', 'cnoc', 'fidchell']; }
      function fields() {
        return ['v', 'game', 'options', 'seats', 'players', 'creator', 'status', 'firstSeat',
                'moves', 'moveCount', 'turn', 'result', 'next', 'createdAt', 'updatedAt'];
      }
      function seated(seats) { return seats.values().removeAll([null]); }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

      allow get: if signedIn();
      allow list: if signedIn() && me() in resource.data.players;
      // The creator may call off a game nobody has joined yet.
      allow delete: if signedIn() && resource.data.status == 'open'
        && resource.data.creator == me() && resource.data.players == [me()];

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(fields())
        && request.resource.data.keys().hasOnly(fields())
        && request.resource.data.v == 1
        && onlineGame(request.resource.data.game)
        && request.resource.data.options is map
        && request.resource.data.creator == me()
        && request.resource.data.players == [me()]
        && request.resource.data.seats is map
        && request.resource.data.seats.size() == 2
        && seated(request.resource.data.seats) == [me()]
        && request.resource.data.firstSeat in request.resource.data.seats.keys()
        && request.resource.data.status == 'open'
        && request.resource.data.moves == {}
        && request.resource.data.moveCount == 0
        && request.resource.data.turn == null
        && request.resource.data.result == null
        && request.resource.data.next == null
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;

      // Take the empty seat. When both seats are full the game starts with firstSeat's player to act.
      function joining() {
        let r = resource.data;
        let d = request.resource.data;
        let full = seated(d.seats).size() == d.seats.size();
        return r.status == 'open'
          && !(me() in r.players)
          && changed().hasOnly(['seats', 'players', 'status', 'turn', 'updatedAt'])
          && d.seats.diff(r.seats).changedKeys().size() == 1
          && d.seats.diff(r.seats).addedKeys().size() == 0
          && d.seats.diff(r.seats).removedKeys().size() == 0
          && seated(d.seats).size() == seated(r.seats).size() + 1
          && me() in d.seats.values()
          && d.players == r.players.concat([me()])
          && (full ? (d.status == 'active' && d.turn == d.seats[r.firstSeat])
                   : (d.status == 'open' && d.turn == null));
      }

      // Add one move on your own turn; the moves before it can't change.
      // Moves are stored as a map from their index ("0", "1", …) plus a count.
      function moving() {
        let r = resource.data;
        let d = request.resource.data;
        let n = r.moveCount;
        return r.status == 'active'
          && r.turn == me()
          && changed().hasOnly(['moves', 'moveCount', 'turn', 'status', 'result', 'updatedAt'])
          && n < 1000
          && d.moveCount == n + 1
          && d.moves.diff(r.moves).addedKeys() == [string(n)].toSet()
          && d.moves.diff(r.moves).changedKeys().size() == 0
          && d.moves.diff(r.moves).removedKeys().size() == 0
          && ((d.status == 'active' && d.turn in r.players && d.result == null)
              || (d.status == 'done' && d.turn == null && d.result is map));
      }

      function resigning() {
        let d = request.resource.data;
        return resource.data.status == 'active'
          && me() in resource.data.players
          && changed().hasOnly(['status', 'turn', 'result', 'updatedAt'])
          && d.status == 'done' && d.turn == null
          && d.result is map && d.result.resigned is string;
      }

      function offeringRematch() {
        return resource.data.status == 'done'
          && me() in resource.data.players
          && resource.data.next == null
          && changed().hasOnly(['next', 'updatedAt'])
          && request.resource.data.next is string;
      }

      allow update: if signedIn()
        && request.resource.data.updatedAt is int
        && (joining() || moving() || resigning() || offeringRematch());
    }

    match /stats/games {
      function tallied() {
        return ['monsiv', 'fidchell', 'lock', 'fiche', 'cnoc', 'cnoc-mor', 'fidchell-cups', 'goldmines', 'roth'];
      }
      function upByOne(k) {
        return !(k in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data[k] == resource.data.get(k, 0) + 1;
      }

      allow get: if true;
      allow list, delete: if false;
      allow create: if request.resource.data.keys().size() == 1
        && request.resource.data.keys().hasOnly(tallied())
        && request.resource.data.values()[0] == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(tallied())
        && upByOne('monsiv') && upByOne('fidchell') && upByOne('lock') && upByOne('fiche')
        && upByOne('cnoc') && upByOne('cnoc-mor') && upByOne('fidchell-cups') && upByOne('goldmines') && upByOne('roth');
    }

    // ---------- Match records (src/online/telemetry.ts) ----------
    // telemetry/{id}: one finished or abandoned Roth Catha match, for balancing the cards: the setup, both decks, the
    //   seed, every choice (by index) and the result. No name, account or id. Anyone may add one (the site sends them
    //   only for visitors who allowed visit statistics); nobody may change or delete one; only the site's admins
    //   may read them.
    // admins/{uid}: the accounts that may read match records. Made by hand in the Firebase console (a document
    //   whose id is the owner's uid, shown on #/telemetry when signed in); nobody can write it from the site.
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow get: if signedIn() && uid == me();
      allow list, create, update, delete: if false;
    }

    match /telemetry/{id} {
      function recordOk(d) {
        let m = d.match;
        return d.keys().hasAll(['v', 'game', 'build', 'at', 'outcome', 'match'])
          && d.keys().hasOnly(['v', 'game', 'build', 'at', 'outcome', 'match'])
          && d.v == 1 && d.game == 'roth'
          && d.build is string && d.build.size() <= 40
          && d.at is int
          && d.outcome in ['won', 'lost', 'drawn', 'abandoned']
          && m is map
          && m.keys().hasOnly(['setup', 'me', 'seed', 'decks', 'moves', 'undos', 'ms', 'phase', 'duel', 'result'])
          && m.moves is list && m.moves.size() <= 4000
          && m.decks is map && m.decks.first is list && m.decks.second is list
          && m.decks.first.size() <= 80 && m.decks.second.size() <= 80;
      }
      allow create: if recordOk(request.resource.data);
      allow get, list: if admin();
      allow update, delete: if false;
    }

    // ---------- Lock races ----------
    function diffKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function raceOptionsOk(o) {
      return o is map
        && o.keys().hasAll(['minutes', 'kind', 'tier', 'resets', 'penalty', 'bonus'])
        && o.keys().hasOnly(['minutes', 'kind', 'tier', 'resets', 'penalty', 'bonus'])
        && o.minutes in [1, 3, 5, 10] && o.kind in ['dial', 'cube', 'cross'] && o.tier in [1, 2, 3, 4, 5]
        && o.resets in ['free', 'none'] && o.penalty is bool && o.bonus is bool;
    }
    function nameOk(n) { return n == null || (n is string && n.size() <= 40); }
    // Seconds lost per failed try (10 per minute of race) and gained per lock (race/engine.ts BONUS_TABLE).
    function penaltyEach(o) { return o.penalty ? o.minutes * 10 : 0; }
    function bonusEach(o) {
      return o.bonus ? {'1': [1, 1, 2, 2, 3], '3': [1, 2, 2, 3, 4], '5': [2, 2, 3, 4, 5], '10': [2, 3, 4, 5, 5]}[string(o.minutes)][o.tier - 1] : 0;
    }
    // Total bonus after n locks, capped at the race's length (so a clock can at most double).
    function bonusFor(o, n) { return n * bonusEach(o) <= o.minutes * 60 ? n * bonusEach(o) : o.minutes * 60; }
    function runKeys() { return ['solves', 'fails', 'bonus', 'penalty', 'finished', 'finishedAt']; }
    function zeroRun(r) { return r == {'solves': 0, 'fails': 0, 'bonus': 0, 'penalty': 0, 'finished': false, 'finishedAt': null}; }
    // A run moves on: counts only grow, bonus and penalty follow from them, nothing changes after the finish.
    function runGrows(o, old, nu) {
      return old.finished == false
        && nu.solves is int && nu.fails is int && nu.solves >= old.solves && nu.fails >= old.fails
        && nu.solves <= 2000 && nu.fails <= 2000
        && nu.bonus == bonusFor(o, nu.solves) && nu.penalty == nu.fails * penaltyEach(o)
        && nu.finished is bool
        && (nu.finished ? nu.finishedAt is int : nu.finishedAt == null);
    }
    // Runs can be reported until twice the race's length (the most a clock can hold) plus 5 minutes.
    function inWindow(startedAt, o) { return request.time < startedAt + duration.value(o.minutes * 120 + 300, 's'); }

    match /races/{raceId} {
      function raceFields() {
        return ['v', 'options', 'seed', 'creator', 'seats', 'players', 'names', 'status', 'ready', 'runs',
                'startedAt', 'next', 'createdAt', 'updatedAt'];
      }
      function raceSeat(r) { return r.seats.a == me() ? 'a' : 'b'; }

      allow get: if signedIn();
      allow list: if signedIn() && me() in resource.data.players;
      // The creator may call off a race nobody has joined yet.
      allow delete: if signedIn() && resource.data.status == 'open'
        && resource.data.creator == me() && resource.data.players == [me()] && resource.data.seats.b == null;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(raceFields())
        && request.resource.data.keys().hasOnly(raceFields())
        && request.resource.data.v == 1
        && raceOptionsOk(request.resource.data.options)
        && request.resource.data.seed is int && request.resource.data.seed >= 0
        && request.resource.data.creator == me()
        && request.resource.data.seats == {'a': me(), 'b': null}
        && request.resource.data.players == [me()]
        && request.resource.data.names.keys().hasOnly(['a', 'b'])
        && nameOk(request.resource.data.names.a) && request.resource.data.names.get('b', null) == null
        && request.resource.data.status == 'open'
        && request.resource.data.ready == {'a': false, 'b': false}
        && request.resource.data.runs.keys().hasOnly(['a', 'b'])
        && zeroRun(request.resource.data.runs.a) && zeroRun(request.resource.data.runs.b)
        && request.resource.data.startedAt == null
        && request.resource.data.next == null
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;

      // The second racer takes seat b, once.
      function joiningRace() {
        let r = resource.data;
        let d = request.resource.data;
        return r.status == 'open' && r.seats.b == null && !(me() in r.players)
          && diffKeys().hasOnly(['seats', 'players', 'names', 'status', 'updatedAt'])
          && d.seats == {'a': r.seats.a, 'b': me()}
          && d.players == r.players.concat([me()])
          && d.names.a == r.names.a && nameOk(d.names.b)
          && d.status == 'ready';
      }

      // A racer says they're ready (their own flag only). The second one starts the race, stamped with server time.
      function readying() {
        let r = resource.data;
        let d = request.resource.data;
        let s = raceSeat(r);
        let both = d.ready.a == true && d.ready.b == true;
        return r.status == 'ready' && me() in r.players
          && diffKeys().hasOnly(['ready', 'status', 'startedAt', 'updatedAt'])
          && d.ready.diff(r.ready).affectedKeys() == [s].toSet()
          && d.ready[s] == true
          && (both ? (d.status == 'running' && d.startedAt == request.time)
                   : (d.status == 'ready' && d.startedAt == null));
      }

      // A racer reports their own run; a finished run may also close the race.
      function racing() {
        let r = resource.data;
        let d = request.resource.data;
        let s = raceSeat(r);
        return r.status in ['running', 'done'] && me() in r.players
          && inWindow(r.startedAt, r.options)
          && diffKeys().hasOnly(['runs', 'status', 'updatedAt'])
          && d.runs.diff(r.runs).affectedKeys().hasOnly([s])
          && d.runs[s].keys().hasAll(runKeys()) && d.runs[s].keys().hasOnly(runKeys())
          && runGrows(r.options, r.runs[s], d.runs[s])
          && (d.status == r.status || (r.status == 'running' && d.status == 'done' && d.runs[s].finished == true));
      }

      // A racer whose own run is finished closes the race (e.g. the other racer went away).
      function endingRace() {
        let r = resource.data;
        return r.status == 'running' && me() in r.players
          && r.runs[raceSeat(r)].finished == true
          && diffKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'done';
      }

      function offeringRaceRematch() {
        return resource.data.status == 'done'
          && me() in resource.data.players
          && resource.data.next == null
          && diffKeys().hasOnly(['next', 'updatedAt'])
          && request.resource.data.next is string;
      }

      allow update: if signedIn()
        && request.resource.data.updatedAt is int
        && (joiningRace() || readying() || racing() || endingRace() || offeringRaceRematch());

      // A challenger's score for this race's locks: one per player, never by the two racers.
      match /scores/{uid} {
        function theRace() { return get(/databases/$(database)/documents/races/$(raceId)).data; }
        function scoreKeys() { return ['uid', 'name', 'solves', 'fails', 'bonus', 'penalty', 'finished', 'finishedAt', 'startedAt', 'updatedAt']; }

        allow get, list: if signedIn();
        allow delete: if false;

        allow create: if signedIn() && uid == me()
          && request.resource.data.keys().hasAll(scoreKeys())
          && request.resource.data.keys().hasOnly(scoreKeys())
          && request.resource.data.uid == me()
          && nameOk(request.resource.data.name)
          && request.resource.data.solves == 0 && request.resource.data.fails == 0
          && request.resource.data.bonus == 0 && request.resource.data.penalty == 0
          && request.resource.data.finished == false && request.resource.data.finishedAt == null
          && request.resource.data.startedAt == request.time
          && request.resource.data.updatedAt is int
          && theRace().status in ['running', 'done']
          && !(me() in theRace().players);

        allow update: if signedIn() && uid == me()
          && diffKeys().hasOnly(['solves', 'fails', 'bonus', 'penalty', 'finished', 'finishedAt', 'updatedAt'])
          && request.resource.data.updatedAt is int
          && runGrows(theRace().options, resource.data, request.resource.data)
          && inWindow(resource.data.startedAt, theRace().options);
      }
    }
  }
}
